+        requestBuilder.set(CaptureRequest.SENSOR_EXPOSURE_TIME, previous.get(CaptureRequest.SENSOR_EXPOSURE_TIME));
+        requestBuilder.set(CaptureRequest.SENSOR_SENSITIVITY, previous.get(CaptureRequest.SENSOR_SENSITIVITY));
+        requestBuilder.set(CaptureRequest.SENSOR_FRAME_DURATION, previous.get(CaptureRequest.SENSOR_FRAME_DURATION));
+    }
