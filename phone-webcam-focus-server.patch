+            }
+            if (exposureTimeRange != null) {
+                exposure += " minTime=" + exposureTimeRange.getLower() + " maxTime=" + exposureTimeLimit();
+            }
+            if (sensitivityRange != null) {
+                exposure += " minIso=" + sensitivityRange.getLower() + " maxIso=" + sensitivityRange.getUpper();
+            }
+            if (compensationRange != null && requestBuilder != null) {
