+        focusCommandName = "scrcpy-focus-command-" + safeCameraId;
+        focusStateFile = new File(FOCUS_DIR, "scrcpy-focus-state-" + safeCameraId);
+        writeFocusState("startup auto " + maxFocusDiopters);
+        exposureCommandName = "scrcpy-exposure-command-" + safeCameraId;
+        torchCommandName = "scrcpy-torch-command-" + safeCameraId;
+        exposureStateFile = new File(FOCUS_DIR, "scrcpy-exposure-state-" + safeCameraId);
+        torchStateFile = new File(FOCUS_DIR, "scrcpy-torch-state-" + safeCameraId);
+        manualExposure = false;
+        baselineExposureTime = null;
+        baselineSensitivity = null;
+        exposureStateText = "startup auto";
+        torchStateText = "startup " + (initialTorch ? "on" : "off");
+        publishCameraStates();
+        focusObserver = new FileObserver(FOCUS_DIR, FileObserver.CLOSE_WRITE | FileObserver.MOVED_TO) {
+            @Override
+            public void onEvent(int event, String path) {
+                if (focusCommandName.equals(path)) {
+                    cameraHandler.post(() -> processFocusCommand());
+                } else if (exposureCommandName.equals(path)) {
+                    cameraHandler.post(() -> processCameraCommand(false));
+                } else if (torchCommandName.equals(path)) {
+                    cameraHandler.post(() -> processCameraCommand(true));
+                }
+            }
+        };
