+    private void processCameraCommand(boolean torch) {
+        assertCameraThread();
+        if (currentSession == null || requestBuilder == null) {
+            return;
+        }
+        String line;
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(
+                new FileInputStream(new File(FOCUS_DIR, torch ? torchCommandName : exposureCommandName)), StandardCharsets.US_ASCII))) {
+            line = reader.readLine();
+        } catch (IOException e) {
+            return;
+        }
+        if (line == null) {
+            return;
+        }
+        String[] fields = line.trim().split(" +");
+        if (fields.length < 2 || !fields[0].matches("[a-zA-Z0-9]{1,32}")) {
+            return;
+        }
+        String nonce = fields[0];
+        CaptureRequest previous = requestBuilder.build();
+        requestBuilder.setTag(nonce);
+        String error = null;
+        try {
+            if (torch) {
+                if (fields.length != 2 || !("on".equals(fields[1]) || "off".equals(fields[1]))) {
+                    error = "invalid-command";
+                } else if (!flashAvailable && "on".equals(fields[1])) {
+                    error = "no-flash";
+                } else {
+                    requestBuilder.set(CaptureRequest.FLASH_MODE,
+                            "on".equals(fields[1]) ? CaptureRequest.FLASH_MODE_TORCH : CaptureRequest.FLASH_MODE_OFF);
+                    setRepeatingRequest(currentSession, requestBuilder.build());
+                    torchStateText = nonce + " " + fields[1];
+                }
+            } else if ("auto".equals(fields[1]) && fields.length == 2) {
+                configureAutoExposure();
+                setRepeatingRequest(currentSession, requestBuilder.build());
+                manualExposure = false;
+                baselineExposureTime = null;
+                baselineSensitivity = null;
+                exposurePercent = 100;
+                exposureStateText = nonce + " auto";
+            } else if ("compensation".equals(fields[1]) && fields.length == 3) {
+                float ev = Float.parseFloat(fields[2]);
+                if (!Float.isFinite(ev) || compensationRange == null || compensationStep <= 0) {
+                    error = "no-compensation";
+                } else if (ev < compensationRange.getLower() * compensationStep - 0.0001
+                        || ev > compensationRange.getUpper() * compensationStep + 0.0001) {
+                    error = "out-of-range";
+                } else {
+                    configureAutoExposure();
+                    int steps = compensationRange.clamp(Math.round(ev / compensationStep));
+                    requestBuilder.set(CaptureRequest.CONTROL_AE_EXPOSURE_COMPENSATION, steps);
+                    setRepeatingRequest(currentSession, requestBuilder.build());
+                    manualExposure = false;
+                    baselineExposureTime = null;
+                    baselineSensitivity = null;
+                    exposureStateText = nonce + " auto";
+                }
+            } else if (("lock".equals(fields[1]) && fields.length == 2)
+                    || ("manual".equals(fields[1]) && fields.length == 3)) {
+                float percent = "lock".equals(fields[1]) ? 100 : Float.parseFloat(fields[2]);
+                if (!Float.isFinite(percent) || percent < 0 || percent > 200) {
+                    error = "out-of-range";
+                } else if (!manualExposureSupported) {
+                    error = "no-manual-exposure";
+                } else if (lastExposureTime == null || lastSensitivity == null) {
+                    error = "no-exposure-result";
+                } else {
+                    // Keep one reference through successive set commands. Lock explicitly establishes a new reference.
+                    long referenceTime = !manualExposure || "lock".equals(fields[1]) ? lastExposureTime : baselineExposureTime;
+                    int referenceIso = !manualExposure || "lock".equals(fields[1]) ? lastSensitivity : baselineSensitivity;
+                    long time = exposureTimeRange.clamp(Math.round(referenceTime * percent / 100.0));
+                    time = Math.min(time, Math.max(exposureTimeRange.getLower(), exposureTimeLimit()));
+                    double target = (double) referenceTime * referenceIso * percent / 100.0;
+                    int iso = sensitivityRange.clamp((int) Math.round(target / time));
+                    requestBuilder.set(CaptureRequest.CONTROL_AE_MODE, CaptureRequest.CONTROL_AE_MODE_OFF);
+                    requestBuilder.set(CaptureRequest.CONTROL_AE_LOCK, false);
+                    requestBuilder.set(CaptureRequest.SENSOR_EXPOSURE_TIME, time);
+                    requestBuilder.set(CaptureRequest.SENSOR_SENSITIVITY, iso);
+                    long frame = fps > 0 ? 1_000_000_000L / fps : lastFrameDuration != null ? lastFrameDuration : time;
+                    requestBuilder.set(CaptureRequest.SENSOR_FRAME_DURATION, Math.max(time, frame));
+                    setRepeatingRequest(currentSession, requestBuilder.build());
+                    manualExposure = true;
+                    baselineExposureTime = referenceTime;
+                    baselineSensitivity = referenceIso;
+                    exposurePercent = percent;
+                    exposureStateText = nonce + " manual";
+                }
+            } else {
+                error = "invalid-command";
+            }
+        } catch (CameraAccessException | IllegalArgumentException | IllegalStateException e) {
+            requestBuilder.set(CaptureRequest.FLASH_MODE, previous.get(CaptureRequest.FLASH_MODE));
+            restoreExposure(previous);
+            error = "camera-rejected";
+            Ln.w("Could not set camera control: " + e.getMessage());
+        }
+        if (error != null) {
+            requestBuilder.setTag(previous.getTag());
+            // Preserve the current mode and values when returning an error.
+            if (torch) {
+                Integer flash = previous.get(CaptureRequest.FLASH_MODE);
+                torchStateText = nonce + " " + (flash != null && flash == CaptureRequest.FLASH_MODE_TORCH ? "on" : "off")
+                        + " error=" + error;
+            } else {
+                exposureStateText = nonce + " " + (manualExposure ? "manual" : "auto") + " error=" + error;
+            }
+        }
+        publishCameraStates();
+    }
+
+    private void setManualFocus(float diopters) throws CameraAccessException {
+        requestBuilder.set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_OFF);
+        requestBuilder.set(CaptureRequest.LENS_FOCUS_DISTANCE, diopters);
+        setRepeatingRequest(currentSession, requestBuilder.build());
+    }
