+    private void processFocusCommand() {
+        assertCameraThread();
+        if (currentSession == null || requestBuilder == null) {
+            return;
+        }
+        String command;
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(
+                new FileInputStream(new File(FOCUS_DIR, focusCommandName)), StandardCharsets.US_ASCII))) {
+            command = reader.readLine();
+        } catch (IOException e) {
+            Ln.w("Could not read focus command: " + e.getMessage());
+            return;
+        }
+        if (command == null) {
+            return;
+        }
+        String[] fields = command.trim().split(" ");
+        if (fields.length < 2 || !fields[0].matches("[a-zA-Z0-9]{1,32}")) {
+            return;
+        }
+        String nonce = fields[0];
+        if (maxFocusDiopters <= 0 && !"auto".equals(fields[1])) {
+            writeFocusState(nonce + " error fixed-lens");
+            return;
+        }
+        try {
+            switch (fields[1]) {
+                case "auto":
+                    requestBuilder.set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_VIDEO);
+                    requestBuilder.set(CaptureRequest.LENS_FOCUS_DISTANCE, null);
+                    setRepeatingRequest(currentSession, requestBuilder.build());
+                    writeFocusState(nonce + " auto " + maxFocusDiopters);
+                    break;
+                case "lock":
+                    if (lastFocusDiopters == null) {
+                        writeFocusState(nonce + " error no-focus-result");
+                        return;
+                    }
+                    setManualFocus(lastFocusDiopters);
+                    writeFocusState(nonce + " manual " + lastFocusDiopters + " " + maxFocusDiopters);
+                    break;
+                case "manual":
+                    if (fields.length != 3) {
+                        writeFocusState(nonce + " error invalid-command");
+                        return;
+                    }
+                    float percent = Float.parseFloat(fields[2]);
+                    if (!Float.isFinite(percent) || percent < 0 || percent > 200) {
+                        writeFocusState(nonce + " error out-of-range");
+                        return;
+                    }
+                    float diopters = maxFocusDiopters * percent / 100;
+                    setManualFocus(diopters);
+                    writeFocusState(nonce + " manual " + diopters + " " + maxFocusDiopters);
+                    break;
+                default:
+                    writeFocusState(nonce + " error invalid-command");
+            }
+        } catch (CameraAccessException | IllegalArgumentException e) {
+            writeFocusState(nonce + " error camera-rejected");
+            Ln.w("Could not set focus: " + e.getMessage());
+        }
+    }
